{
  "manifest_version": 3,
  "name": "RedGifs Extension",
  "description": "manifest.json description",
  "version": "0.1.54",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.redgifs.com/*",
    "https://media.redgifs.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RG Scroller — Links guardados",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.redgifs.com/*"
      ],
      "all_frames": true,
      "js": [
        "content-scripts/content.js"
      ]
    }
  ]
}